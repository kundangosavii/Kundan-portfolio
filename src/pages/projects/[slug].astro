---
import { getCollection, getEntryBySlug } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { SquareArrowOutUpRight } from 'lucide-react';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const project = await getEntryBySlug('projects', slug ?? '');

if (!project) {
  throw new Error('Project not found');
}

const { Content } = await project.render();
---

<MainLayout title={`${project.data.title} - Projects - Kundan Gosavi`}>
  <section class="min-h-[calc(100svh-88px)] bg-white px-6 pt-16 pb-16 dark:bg-black md:px-10 md:pt-16">
    <div class="mx-auto max-w-4xl">
      <p class="mb-3 text-sm font-mono text-gray-500 dark:text-gray-400">{project.data.date}</p>
      <h1 class="mb-3 font-playfair text-5xl text-zinc-900 dark:text-white">{project.data.title}</h1>
      <p class="mb-6 text-gray-700 dark:text-gray-300">{project.data.hook}</p>

      <div class="mb-6 flex flex-wrap gap-2">
        {project.data.tags.map((tag) => (
          <span class="rounded border border-gray-300 bg-gray-100 px-3 py-1 font-mono text-xs dark:border-zinc-700 dark:bg-zinc-800">
            {tag}
          </span>
        ))}
      </div>

      <div class="mb-10 flex items-center gap-4">
        {project.data.projectUrl && (
          <a href={project.data.projectUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-mono text-black dark:text-white">
            <SquareArrowOutUpRight client:load size={20} strokwidth={2} /><span class="text-lg"></span>
          </a>
        )}
        {project.data.githubUrl && (
          <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-mono text-gray-900 dark:text-gray-100">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.41-4.04-1.41-.55-1.38-1.34-1.75-1.34-1.75-1.09-.75.08-.74.08-.74 1.21.08 1.85 1.22 1.85 1.22 1.07 1.82 2.8 1.29 3.48.98.11-.77.42-1.29.76-1.59-2.67-.3-5.47-1.32-5.47-5.87 0-1.3.47-2.37 1.24-3.21-.12-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.22a11.6 11.6 0 0 1 6 0c2.29-1.54 3.3-1.22 3.3-1.22.66 1.65.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.21 0 4.56-2.81 5.56-5.49 5.86.43.37.81 1.1.81 2.22v3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .5z"/>
            </svg>
          </a>
        )}
      </div>

      {project.data.thumbnail && (
        <div class="mb-12 rounded-md border border-gray-300 dark:border-zinc-700">
          <img src={project.data.thumbnail} alt={project.data.altText} class="w-full rounded-md object-cover" />
        </div>
      )}

      <article class="post-body bg-zinc-50 py-4 dark:border-transparent dark:bg-black dark:shadow-none px- sm:px-6 md:px-10 md:py-6">
        <Content />
      </article>
    </div>
  </section>
</MainLayout>


<style>
  .blog-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    scroll-margin-top: 7.5rem;
  }

  .post-body :global(h2) {
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.7rem, 1.45rem + 0.8vw, 2.15rem);
    color: rgb(17 24 39);
  }

  .post-body :global(h3) {
    margin-top: 1.7rem;
    margin-bottom: 0.75rem;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.6rem);
    color: rgb(31 41 55);
  }

  .post-body :global(p),
  .post-body :global(li) {
    line-height: 1.9;
    font-size: clamp(0.95rem, 0.92rem + 0.16vw, 1.06rem);
    color: rgb(63 63 70);
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  .post-body :global(a) {
    color: rgb(2 132 199);
    text-decoration: underline;
    text-decoration-color: rgb(2 132 199 / 0.45);
    text-underline-offset: 3px;
  }

  .post-body :global(a:hover) {
    color: rgb(3 105 161);
  }

  .post-body :global(pre) {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 0.9rem;
    border: 1px solid rgb(228 228 231);
    background: rgb(250 250 250);
    padding: 1rem;
    overflow-x: auto;
  }

  .post-body :global(blockquote) {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-left: 3px solid rgb(2 132 199);
    padding-left: 1rem;
    color: rgb(63 63 70);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.3rem;
  }

  :global(html.dark) .post-body :global(h2) {
    color: rgb(244 244 245);
  }

  :global(html.dark) .post-body :global(h3) {
    color: rgb(228 228 231);
  }

  :global(html.dark) .post-body :global(p),
  :global(html.dark) .post-body :global(li) {
    color: rgb(212 212 216);
  }

  :global(html.dark) .post-body :global(a) {
    color: rgb(125 211 252);
    text-decoration-color: rgb(14 116 144 / 0.55);
  }

  :global(html.dark) .post-body :global(a:hover) {
    color: rgb(186 230 253);
  }

  :global(html.dark) .post-body :global(pre) {
    border: 1px solid rgb(39 39 42);
    background: rgb(9 9 11);
  }

  :global(html.dark) .post-body :global(blockquote) {
    border-left-color: rgb(14 116 144);
    color: rgb(212 212 216);
  }
</style>